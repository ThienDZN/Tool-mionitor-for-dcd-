# Cấu hình cá nhân. Sao chép file này thành .env rồi điền giá trị của riêng bạn.
# Không commit .env hoặc chia sẻ token, endpoint nội bộ, hay lựa chọn model cá nhân.

# Bắt buộc: chỉ điền trong .env cục bộ.
OPENAI_API_KEY=
OPENAI_MODEL=

# Tuỳ chọn: chỉ đặt khi bạn dùng endpoint tương thích riêng.
# OPENAI_BASE_URL=
# OPENAI_REASONING_EFFORT=

# An toàn hơn cho lần chạy đầu: chỉ bật monitoring từ tray sau khi kiểm tra cấu hình.
AUTO_START_MONITORING=0

# Tuỳ chọn giao diện và giới hạn dữ liệu gửi đi.
OVERLAY_DURATION_MS=14000
OVERLAY_FONT_POINT_SIZE=8
MAX_CLIPBOARD_CHARS=4000
MAX_RESPONSE_CHARS=480
REQUEST_TIMEOUT_S=40

# Không dùng web fallback mặc định. Đặt 1 chỉ khi bạn chấp nhận gửi ngữ cảnh ra ngoài.
ENABLE_WEB_FALLBACK=0
WEB_SEARCH_CONTEXT_SIZE=medium

# Tuỳ chọn: đường dẫn tương đối với thư mục project.
# RESOURCES_DIR=resources
# SESSION_CONTEXT_PATH=state/session_context.json

# Tuỳ chọn: bỏ comment và đặt prompt của riêng bạn trong .env.
# SYSTEM_PROMPT=
